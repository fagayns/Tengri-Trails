@page "/{lang}"
@model TengriTrails.Pages.IndexModel
@inject ITextCatalog T
@{
    ViewData["Language"] = Model.Language;
    ViewData["LanguageSuffix"] = "";
    ViewData["Title"] = T.Get("home.title", Model.Language);
}
<section class="hero">
    <div class="hero-sky" aria-hidden="true"></div>
    <div class="cloud cloud-one" aria-hidden="true"></div>
    <div class="cloud cloud-two" aria-hidden="true"></div>
    <div class="cloud cloud-three" aria-hidden="true"></div>
    <svg class="mountain mountain-far" viewBox="0 0 1600 420" preserveAspectRatio="xMidYMax slice" aria-hidden="true">
        <path d="M0 300 180 190l90 75 190-180 170 190 190-145 170 185 190-210 180 160 150-120 190 175v100H0Z" />
    </svg>
    <svg class="mountain mountain-mid" viewBox="0 0 1600 420" preserveAspectRatio="xMidYMax slice" aria-hidden="true">
        <path d="m0 330 180-155 125 110 190-200 130 145 185-105 165 150 175-215 155 180 150-125 145 160v145H0Z" />
    </svg>
    <svg class="mountain mountain-front" viewBox="0 0 1600 420" preserveAspectRatio="xMidYMax slice" aria-hidden="true">
        <path d="m0 300 130-65 150 115 135-145 155 112 210-174 160 170 175-110 160 115 150-95 185 115v182H0Z" />
    </svg>
    <div class="hero-content">
        <p class="eyebrow hero-eyebrow"><span></span>@T.Get("home.eyebrow", Model.Language)</p>
        <h1>@Html.Raw(T.Get("home.headline", Model.Language))</h1>
        <p class="hero-copy">@T.Get("home.subheadline", Model.Language)</p>
        <form class="search-panel" action="/@Model.Language/tours" method="get">
            <label class="search-field">
                <span class="field-icon" aria-hidden="true">⌕</span>
                <span class="sr-only">@T.Get("search.query_label", Model.Language)</span>
                <input type="search" name="query" placeholder="@T.Get("search.placeholder", Model.Language)" />
            </label>
            <label class="search-field region-field">
                <span class="field-icon" aria-hidden="true">⌖</span>
                <span class="sr-only">@T.Get("search.region_label", Model.Language)</span>
                <select name="region">
                    <option value="">@T.Get("search.all_regions", Model.Language)</option>
                    @foreach (var region in Model.Regions)
                    {
                        <option value="@region.Value">@T.Get(region.Key, Model.Language)</option>
                    }
                </select>
            </label>
            <button class="button button-forest search-button" type="submit">@T.Get("search.button", Model.Language)<span aria-hidden="true">↗</span></button>
        </form>
        <div class="hero-footnote"><span class="footnote-line"></span>@T.Get("home.hero_note", Model.Language)</div>
    </div>
    <div class="hero-location"><span>42° 26' N</span><i></i><span>75° 59' E</span></div>
    <a class="scroll-cue" href="#discover"><span></span>@T.Get("home.scroll", Model.Language)</a>
</section>

<section class="section popular-section" id="discover">
    <div class="section-heading">
        <div>
            <p class="eyebrow"><span></span>@T.Get("home.popular_eyebrow", Model.Language)</p>
            <h2>@T.Get("home.popular_title", Model.Language)</h2>
        </div>
        <a class="text-link" href="/@Model.Language/tours">@T.Get("home.view_all", Model.Language)<span aria-hidden="true">↗</span></a>
    </div>
    <div class="tour-grid">
        @foreach (var tour in Model.PopularTours)
        {
            <a class="tour-card" href="/@Model.Language/tours/@tour.Slug">
                <div class="tour-image-wrap">
                    <img src="@tour.ImageUrl" alt="@T.Get(tour.NameKey, Model.Language)" loading="lazy" decoding="async" />
                    <span class="tour-region">@T.Get(tour.RegionKey, Model.Language)</span>
                    <span class="image-arrow" aria-hidden="true">↗</span>
                </div>
                <div class="tour-card-info">
                    <div><h3>@T.Get(tour.NameKey, Model.Language)</h3><span>@T.Get("tour.days", Model.Language, tour.Days)</span></div>
                    <p>@T.Get("tour.from", Model.Language) <strong>@Model.FormatPrice(tour.Price)</strong></p>
                </div>
            </a>
        }
    </div>
</section>

<section class="values-section">
    <div class="values-intro">
        <p class="eyebrow"><span></span>@T.Get("home.why_eyebrow", Model.Language)</p>
        <h2>@T.Get("home.why_title", Model.Language)</h2>
        <p>@T.Get("home.why_copy", Model.Language)</p>
    </div>
    <div class="value-list">
        <article class="value-item">
            <span class="value-icon" aria-hidden="true"><svg viewBox="0 0 48 48"><path d="M24 5 5 41h38L24 5Z" /><path d="m17 27 7-13 8 15H20" /></svg></span>
            <div><h3>@T.Get("home.value1_title", Model.Language)</h3><p>@T.Get("home.value1_copy", Model.Language)</p></div>
            <span class="value-index">01</span>
        </article>
        <article class="value-item">
            <span class="value-icon" aria-hidden="true"><svg viewBox="0 0 48 48"><path d="M5 30c5-6 10-6 15 0s10 6 15 0 8-5 8-5" /><path d="M5 38c5-6 10-6 15 0s10 6 15 0 8-5 8-5M9 19h30M24 5v8" /><circle cx="24" cy="5" r="2" /></svg></span>
            <div><h3>@T.Get("home.value2_title", Model.Language)</h3><p>@T.Get("home.value2_copy", Model.Language)</p></div>
            <span class="value-index">02</span>
        </article>
        <article class="value-item">
            <span class="value-icon" aria-hidden="true"><svg viewBox="0 0 48 48"><circle cx="24" cy="17" r="8" /><path d="M9 42c1-10 6-15 15-15s14 5 15 15M24 5v3M10 17h3M35 17h3" /></svg></span>
            <div><h3>@T.Get("home.value3_title", Model.Language)</h3><p>@T.Get("home.value3_copy", Model.Language)</p></div>
            <span class="value-index">03</span>
        </article>
    </div>
</section>

<section class="regions-section">
    <div class="section-heading regions-heading">
        <div>
            <p class="eyebrow"><span></span>@T.Get("home.regions_eyebrow", Model.Language)</p>
            <h2>@T.Get("home.regions_title", Model.Language)</h2>
        </div>
        <p>@T.Get("home.regions_copy", Model.Language)</p>
    </div>
    <div class="region-chips">
        @foreach (var region in Model.Regions)
        {
            <a class="region-chip" href="/@Model.Language/tours?region=@region.Value">@T.Get(region.Key, Model.Language)<span aria-hidden="true">↗</span></a>
        }
    </div>
</section>
